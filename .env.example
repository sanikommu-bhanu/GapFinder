# Database (SQLite by default — zero external cost, zero network dependency)
DATABASE_URL="file:./dev.db"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Google Gemini API key (used by src/lib/ai/gemini-client.ts for the
# 17-stage analysis pipeline). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Optional: override the Gemini model used by the pipeline
GEMINI_MODEL="gemini-2.0-flash"

NODE_ENV="development"