# ---------------------------------------------------------------------------
# GapFinder environment.
#
# Copy to .env and fill in. .env is gitignored and must stay that way — every
# value below marked "secret" is server-side only and is read exclusively
# through src/lib/env.ts. None of these are ever prefixed NEXT_PUBLIC_, which
# is what would put them in the browser bundle.
#
# The app runs with only DATABASE_URL, SESSION_SECRET and GEMINI_API_KEY set.
# Every other block is optional and degrades to a working fallback.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database — PostgreSQL, local and in production. SECRET.
#
# Any free Postgres works: Neon (neon.tech), Supabase, or Vercel Postgres.
# Create a database, copy its connection string here, then run:
#   npm run db:push && npm run db:seed
#
# Schema changes are pushed from a dev machine, never during a deploy build.
# Note: Neon's free tier suspends an idle endpoint. If db:push reports P1001
# "Can't reach database server", open the Neon console to resume it.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Session signing secret. SECRET.
# Generate with: openssl rand -base64 32
#
# There is no production fallback: a deploy without this fails at boot rather
# than verifying sessions against a value published in the source.
# ---------------------------------------------------------------------------
SESSION_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Google Gemini — the primary AI provider. SECRET.
# Free key from https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_VISION_MODEL="gemini-2.5-flash"
# Used by "Show me" when generating an illustration for an asked concept.
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# ---------------------------------------------------------------------------
# Optional: Groq — the fallback provider. SECRET.
#
# When Gemini hits its free-tier rate limit, the same call is retried here
# instead of dropping straight to the local deterministic layer, so a student
# keeps their explanation quality. Free key, no card: https://console.groq.com
#
# Model ids move faster than this file. If a default retires, list what your
# key can reach:  curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Reading handwriting is the one stage where model quality visibly changes the
# answer, so Groq is NOT used for images unless you opt in here.
GROQ_ALLOW_VISION="false"
GROQ_VISION_MODEL=""

# ---------------------------------------------------------------------------
# AI call tuning. Not secret.
# ---------------------------------------------------------------------------
# How long a cached model response stays valid. Default 168 (7 days).
AI_CACHE_TTL_HOURS="168"
# Retries within one provider before failing over to the next. Quota errors are
# never retried — a free-tier limit is not transient.
AI_MAX_RETRIES="2"

# ---------------------------------------------------------------------------
# Optional: YouTube Data API v3 key. SECRET.
#
# Without it, video recommendations degrade to a targeted search handoff —
# GapFinder will never invent a video title, channel or URL. With it, results
# are real, checked as public and embeddable, and cached per concept.
# Free from https://console.cloud.google.com (enable "YouTube Data API v3").
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=""

# ---------------------------------------------------------------------------
# Optional: OpenAlex polite-pool identifier. NOT a secret.
#
# OpenAlex is free and keyless (100k requests/day). Sending an email address
# joins the "polite pool", which OpenAlex asks for and rewards with better
# throughput. It is an identifier, not a credential — leave blank to opt out.
# ---------------------------------------------------------------------------
OPENALEX_MAILTO=""

# ---------------------------------------------------------------------------
# Optional: GitHub token for "See it in the real world". SECRET.
#
# Repository discovery works with no token at all; the token only raises the
# search rate limit from 10/min to 30/min. A fine-grained token with NO scopes
# selected is sufficient — this only ever reads public search results.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=""

# ---------------------------------------------------------------------------
# Optional: Spotify, for Focus Mode.
#
# The flow is Authorization Code + PKCE. The client secret is OPTIONAL: PKCE
# alone proves the token request came from the browser that started the flow.
# Set it to additionally authenticate as a confidential client (recommended
# when you have a server, which this app does).
#
# Focus Mode is fully functional without any of this — the music card renders
# nothing at all when these are unset, and the timer, objective and mastery
# ring are unaffected.
#
# Create an app at https://developer.spotify.com/dashboard, then add the exact
# redirect URI below to the app's settings (it must match character for
# character, including the port).
#
# Two limits worth knowing before you rely on this in a demo:
#   * Controlling playback requires the listener to have Spotify Premium.
#     Spotify enforces this; the card shows what is playing on any plan but
#     hides the transport controls without Premium.
#   * A new app starts in development mode, limited to a small number of users
#     who must each be added by email in the dashboard. Add every account that
#     will sign in before the demo.
#
# CLIENT_ID and REDIRECT_URI are required; the secret is optional (PKCE).
# The redirect URI must be registered in the dashboard character for character.
# Register BOTH your local and production URIs there:
#   http://127.0.0.1:3000/spotify/callback
#   https://<your-domain>/spotify/callback
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/spotify/callback"
