# ---------------------------------------------------------------------------
# Database — PostgreSQL, local and in production.
#
# Any free Postgres works: Neon (neon.tech), Supabase, or Vercel Postgres.
# Create a database, copy its connection string here, then run:
#   npm run db:push && npm run db:seed
#
# Schema changes are pushed from a dev machine, never during a deploy build.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Session signing secret — generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Google Gemini. Free key from https://aistudio.google.com/apikey
# Server-side only — never referenced from a client component.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_VISION_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------------------
# Optional: YouTube Data API v3 key.
#
# Without it, video recommendations degrade to a targeted search handoff —
# GapFinder will never invent a video title, channel or URL. With it, results
# are real, checked as public and embeddable, and cached per concept.
# Free from https://console.cloud.google.com (enable "YouTube Data API v3").
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=""

# ---------------------------------------------------------------------------
# Optional: Groq — the fallback provider.
#
# When Gemini hits its free-tier rate limit, the same call is retried here
# instead of dropping straight to the local deterministic layer, so a student
# keeps their explanation quality. Free key, no card: https://console.groq.com
#
# Model ids move faster than this file. If a default retires, list what your
# key can reach:  curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Reading handwriting is the one stage where model quality visibly changes the
# answer, so Groq is NOT used for images unless you opt in here.
GROQ_ALLOW_VISION="false"
GROQ_VISION_MODEL=""
